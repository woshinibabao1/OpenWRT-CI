#!/bin/sh
# SPDX-License-Identifier: MIT
# H5000M 5G CPE 网络调优 —— 首次开机由 uci-defaults 执行一次，执行后自动删除。
#
# 只做「低风险且可回滚」的项。SQM/CAKE 的限速速率需要真实上下行带宽，
# 固件里不预设，刷机后请到「网络 → SQM QoS」按实测值填写（建议填带宽的 90%）。

# ---------- 1. flow offload：编译期选型（/etc/mt5700/flow-offload）+ 运行期与 SQM 互斥 ----------
# 选型来源：构建期由 Scripts/ApplyFlowOffload.sh 写入固件 files 覆盖层
#   /etc/mt5700/flow-offload（一行 MODE=<auto|off|on|on-hw>，默认 auto）。
#   也可刷机后在「网络 → 防火墙 → 常规设置」或 uci 改 firewall.@defaults[0].flow_offloading。
# 实测依据（2026-09-18 真机只读体检，固件 r0-3e24625 / kernel 6.18.44）：
#   · /sys/kernel/debug/ppe0 与 ppe1 存在 → MediaTek PPE 硬件转发表在；
#   · eth0 / eth1 的 `ethtool -k` 显示 hw-tc-offload: on → mtk_soc_eth 支持
#     nf_flow_table 硬件卸载；
#   · /lib/modules/<kver>/ 里没有 mtk_wed.ko → WiFi 侧硬件转发（WED）本基线缺失；
#   · 上网出口是 eth2（5G 模组，USB CDC-NCM），PPE 只挂在 SoC 以太网口上，
#     管不到 USB 口。
# 结论（★ 2026-09-21 更正本段旧说法）：软件卸载（nf_flow_table 快转路径）对**所有**
#       接口都有效，包括 USB 5G WAN，是本机型唯一确定拿得到的加速。
#       **但默认值是 off，不是 auto** —— Files/etc/mt5700/flow-offload 写的是 MODE=off，
#       Scripts/ApplyFlowOffload.sh 的兜底默认也是 off。因为本固件带 TTL 归一规则，而卸载
#       会把连接从 nftables 路径上摘走，两者不可共存（真机实证：开着卸载时客户端 HTTP
#       25 秒超时、conntrack 带 [OFFLOAD]、出口 TTL 不受规则控制；关掉后同一请求 HTTP 200
#       / 1.0 秒）。即：下面 auto 分支里的 TTL 探测只在**显式**选择 auto 时才会走到。
#       硬件卸载在这台机器上只可能命中「有线 LAN↔有线 LAN」这一类流量，
#       命中率≈0，开了还会让 nft 计数器看不到流量（排障变难），故 on-hw 也仅在有线场景有意义。
#       （MT7987 的 WED 经查属上游未完成：设备树有 wed 节点，但 modules.builtin 里没有
#        mtk_wed、主线驱动无该 SoC 匹配、上游 linux-firmware 无 mt7987_wo.bin —— 见
#        CLOSED_SOURCE_AUDIT.md。等上游补齐后再谈 on-hw。）
#
# 与 SQM/CAKE 互斥：被卸载的连接完全绕过 qdisc，CAKE/HTB 一律失效。
#   故 auto 模式下先查 SQM：已启用就保持 offload 关闭（保住整形），两者只能二选一；
#   on/on-hw 模式用户显式要卸载，则按显式值执行，但 SQM 启用时记一条警告（SQM 会失效）。
#
# 回滚：网络 → 防火墙 → 常规设置，取消「Flow Offloading」；或
#       uci set firewall.@defaults[0].flow_offloading=0 && uci commit firewall

# 读取编译期选型（文件缺失 / 为空 / 非法值一律回退 auto，绝不因配置错而中断开机）
MODE=auto
if [ -f /etc/mt5700/flow-offload ]; then
	. /etc/mt5700/flow-offload 2>/dev/null || MODE=auto
	case "$MODE" in
		auto|off|on|on-hw) ;;
		*) MODE=auto; logger -t mt5700-net "flow-offload: 非法 MODE，回退 auto" ;;
	esac
else
	MODE=auto
fi

# SQM 扫描：永远执行、结果永远记录（红线2：offload/SQM 互斥判定无论 MODE 都跑）
SQM_ON=0
for S in $(uci -q show sqm 2>/dev/null | grep -E "\.enabled='1'"); do
	SQM_ON=1
done

# 决策矩阵（P02）
flow_offloading=0
flow_offloading_hw=0
case "$MODE" in
	auto)
		# ★ TTL 统一规则优先判定：offload 会把连接从 nftables 路径上摘走，
		#   TTL 规则（postrouting）对快转包完全不执行 —— 真机实证见下方注释。
		#   即使 SQM 未启用，只要固件带了 TTL 规则就必须关卸载，否则规则形同虚设。
		TTL_RULE=0
		for F in /etc/nftables.d/*.nft; do
			[ -f "$F" ] || continue
			if grep -q 'ip ttl set' "$F" 2>/dev/null; then TTL_RULE=1; break; fi
		done
		if [ "$TTL_RULE" -eq 1 ]; then
			flow_offloading=0; flow_offloading_hw=0
			logger -t mt5700-net "检测到 TTL 统一规则，保持 flow offload 关闭（offload 绕过 nftables，TTL 改不到）"
		elif [ "$SQM_ON" -eq 1 ]; then
			flow_offloading=0; flow_offloading_hw=0
			logger -t mt5700-net "SQM 已启用，保持 flow offload 关闭（二者互斥：offload 绕过 qdisc）"
		else
			flow_offloading=1; flow_offloading_hw=0
			logger -t mt5700-net "已开启软件 flow offload（auto 且 SQM/TTL 规则均未启用，无冲突）；硬件卸载留待 mtk_wed 就位"
		fi
		;;
	off)
		flow_offloading=0; flow_offloading_hw=0
		;;
	on)
		flow_offloading=1; flow_offloading_hw=0
		if [ "$SQM_ON" -eq 1 ]; then
			logger -t mt5700-net "警告：MODE=on 但 SQM 已启用，offload 会绕过 qdisc 使 SQM 失效"
		fi
		;;
	on-hw)
		flow_offloading=1; flow_offloading_hw=1
		if [ "$SQM_ON" -eq 1 ]; then
			logger -t mt5700-net "警告：MODE=on-hw 但 SQM 已启用，offload 会绕过 qdisc 使 SQM 失效"
		fi
		;;
esac
uci -q set firewall.@defaults[0].flow_offloading="$flow_offloading"
uci -q set firewall.@defaults[0].flow_offloading_hw="$flow_offloading_hw"
uci -q commit firewall

# ---------- 2. 应用 TCP / 拥塞控制参数 ----------
# 参数文件随固件提供（/etc/sysctl.d/99-mt5700-tcp.conf），
# 开机由 sysctl 服务加载；这里立即应用一次，保证本次开机就生效。
if [ -f /etc/sysctl.d/99-mt5700-tcp.conf ]; then
	# BBR 模块若未自动加载，先显式载入（失败不影响其余参数）
	modprobe tcp_bbr 2>/dev/null || true
	sysctl -p /etc/sysctl.d/99-mt5700-tcp.conf 2>/dev/null || true
fi

# ---------- 3. 中断均衡（硬件中断亲和）----------
# 由 mt5700-smp 接管（在 99-mt5700-sys 里启用）。
# 本文件原先在此显式停用 irqbalance，2026-09-21 起该逻辑已删除：
# irqbalance 已从编译配方中移除（Config/GENERAL.txt 里三个符号 =n），固件中不存在，
# 「停用一个不存在的服务」是死代码。
# 移除依据（真机实测，当时还装着 irqbalance）：无线 mt7996e（IRQ 79）与 USB 5G 模组
#   （IRQ 74）**100% 压在 CPU0**，累计 186 万次从未迁移过；irqbalance 全程只动了
#   以太网的两个中断（67→CPU1、68→CPU3），对负载最大的两个毫无作为。
#   ★ 关键认知：**smp_affinity 写成全核 f 不等于分摊** —— 单条 MSI 中断每次仍由
#     内核选定的一个核响应，实测固定 CPU0。要搬走必须写**单核**掩码。
# ⚠️ 即便换用 mt5700-smp 也做不到完全均分：IRQ 79 的亲和驱动不支持写入
#    （echo 返回 RC=1、effective_affinity=0），只能留在 CPU0。
# 若日后手动安装 irqbalance，必须自行执行 /etc/init.d/irqbalance disable：
#   它与 mt5700-smp 都写 /proc/irq/*/smp_affinity，同时开启会互相覆盖。
# 责任划分：mt5700-smp = 硬件中断亲和；mt5700-rps = 收包软中断 RPS（见第 4 节）

# ---------- 4. 数据包引导（packet steering / RPS）----------
# 把收包软中断按流散列到多个核，与 mt5700-smp（硬中断亲和）配合打破
# 「中断全压 CPU0」的格局。两者不冲突：RPS 写 RPS 掩码，mt5700-smp 写 smp_affinity。
#
# ⚠️ 2026-09-21 实测更正：这里原来只写了
#       if [ -f /etc/init.d/packet_steering ]; then ... enable; fi
#   但真机 `uci show network.globals` 里**没有 packet_steering 键**，
#   rps_cpus 停在单核掩码（phy0.1-ap0=4 → CPU2、eth2=8 → CPU3），等于没生效：
#   netifd 的 packet steering 是**靠 uci 配置驱动**的，不是靠那个 init 脚本。
#   所以这里必须显式写 uci，并用 mt5700-rps 在开机后兜底强制全核掩码。
#
# 实测依据（8 条并发 TCP 流、压测 12 秒）：
#   单核掩码：NET_RX 软中断 95% 集中在一个核，softirq 112 jiffies 全压一核
#   全核掩码：NET_RX 分散到 CPU0/CPU1/CPU3（≈37%/27%/36%），
#             softirq 109 / 80 / 94 jiffies 分散到三核
# ⚠️ 验证必须用**多流**：RPS 按 flow hash 选核，同一条 TCP 流的所有包
#    必然落在同一个核（避免乱序），单流压测会误判成"全核掩码反而更差"。

# ⚠️⚠️ 2026-09-22 实测推翻了下面这段旧做法，改为**关掉** packet steering（见 4a）。
# 旧注释留着是为了记录当时的误判，别照着恢复。
#
# 4a. netifd 原生 packet steering —— 必须关掉，不能再用（2026-09-22 实测）
#
# 冲突实锤（2026-09-22，本机 4 核 MT7987，**全程未动任何真实接口**）：
#   1. 手工写入 mt5700-rps 的期望值：phy0.1-ap0=e、br-lan=f、eth2=f
#   2. 触发「用户在 LuCI 保存一次配置」的等价事件：
#        ubus call service event '{"type":"config.change","data":{"package":"firewall"}}'
#      换成 package=network 结果一样 —— /etc/init.d/packet_steering 的
#      service_triggers() 里两者都注册了 procd_add_reload_trigger。
#   3. 回读：phy0.1-ap0 由 e 变成 **4**（CPU2）、eth2 由 f 变成 **8**（CPU3）
#   4. 对照组：先 disable + stop 再重复步骤 2 —— 掩码**原样保持** e / f
#
# ⚠️ 测法教训（别再踩）：想验证这条链路时，`ubus send network.interface ...`
#    之类伪造事件**不会**被 procd 接住，实测掩码纹丝不动，会得到「没有冲突」的
#    假阴性 —— 我第一遍就是这么误判的。可复现的触发方式是上面的 config.change。
#
# 原因：`/usr/libexec/network/packet-steering.uc` 用的是
#   cpu_mask(cpu) = sprintf("%x", 1 << cpu)  → **每队列单核掩码**。
# 也就是说「固件默认 rps_cpus 是单核掩码（phy0.1-ap0=4、eth2=8）」这个现象，
# 根源就是它，不是「没设 uci 键导致没生效」—— 旧注释的诊断是反的。
#
# 而单核掩码正是三档里**最差**的一档（本节上方实测：NET_RX 95% 压在一个核）。
# 开着它，等于让它在运行期**反复把 mt5700-rps 的成果改回最差档**。
#
# ⚠️ 停用要**两道**，缺一不可（2026-09-22 逐条实测）：
#   ① disable —— 删掉 /etc/rc.d/S25packet_steering，管**下次及以后**的开机；
#   ② stop    —— 管**本次开机**。uci-defaults 在 S10 跑，S25 在它之后，
#                而 rc 序列的 /etc/rc.d/S* glob 开机时就展开完了，disable 挡不住本次。
#                服务只要注册着，`interface.*` 与 network/firewall 触发器就活着，
#                之后每次配置变更都会再覆盖一次。
#                这道由 mt5700-rps（START=95 > 25）在写掩码前兜底执行，见该文件。
#
# ⚠️ 这里**绝不能**写 packet_steering='0' 当「关掉」（实测，比单核更糟）：
#   看 /etc/init.d/packet_steering 的 reload_service() —— 它**无条件**执行 ucode，
#     键缺失 → 按「普通模式」跑（= 单核掩码）
#     ='0'   → ucode 收到参数 0 设 disable=true，set_netdev_cpu() 写 **val = 0**
#              → 把所有队列的 RPS **整个关掉**，收包全压在硬中断那个核上
#     ='2'   → all_cpus=true → cpu=-1 → 全核掩码 f（但它会连无线口一起写成 f，
#              覆盖掉 mt5700-rps 为无线避开中断核的 e，仍然不行）
#   所以正确做法是**删掉这个键**并停用服务，而不是设成 0。
if [ -x /etc/init.d/packet_steering ]; then
	uci -q delete network.globals.packet_steering 2>/dev/null
	uci -q commit network
	/etc/init.d/packet_steering disable 2>/dev/null || true
	logger -t mt5700-net "已停用 netifd packet steering（其单核掩码会在配置变更时覆盖 mt5700-rps）；本次开机实例由 mt5700-rps(S95) 兜底停止"
fi

# 4b. 兜底：开机后强制把所有接口的 RPS/XPS 设成全核掩码
#     （netifd 只管它自己管理的设备，且只在接口 up 那一刻设一次）
if [ -f /etc/init.d/mt5700-rps ]; then
	chmod 0755 /etc/init.d/mt5700-rps 2>/dev/null
	/etc/init.d/mt5700-rps enable
fi

# ---------- 5. 无线默认值（对齐厂家基准）----------
# 5a. 给**所有** radio 补 country（厂家 99-wifi-default-country 的同一做法）：
#     无 country 时 reg domain 停在 world(00)，5GHz 信道全部标 no-IR（不能发信标），
#     现象是「无线在 LuCI 里显示为禁用、客户端也搜不到信号」。
#     已有 country 的 radio 跳过，绝不覆盖手动选择（幂等）。
for dev in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device$/\1/p'); do
	[ -n "$(uci -q get wireless.$dev.country)" ] && continue
	uci -q set wireless.$dev.country='CN'
done

# 5b. 5GHz：36 信道 + EHT160。
# ★ 2026-09-21 由 HE160/HE80 改为 **EHT160**，依据：
#   ① 硬件与驱动都支持：`iw phy phy0 info` 明确列出 "EHT Iftypes: AP" 与
#      "EHT-MCS Map (BW = 160)"（网卡 iwinfo 报 MediaTek MT7992E，HW Mode 802.11be）；
#   ② 厂家基准默认就是它：Mwrt 的 99c-wifi-5g-channel-boardb 注释写明
#      "mtwifi.sh hands EVERY board the same 5GHz defaults (channel 36 + EHT160)"；
#   ③ 频谱占用与原先的 HE160 **完全相同**（都是 36-64 的 160MHz 块），不新增 DFS 风险；
#   ④ 收益：启用 EHT 的 4096-QAM，Wi-Fi 7 客户端协商速率约翻倍
#      （同一 MCS 档位下 HE160 2SS 实测 1441 Mbit/s）。
#   ⚠️ `iw reg get` 显示 CN 域 `(5150 - 5350 @ 160)`，即 36-64 允许 160MHz 带宽，
#      但该块跨 UNII-2A（52-64）属 DFS，reg 标注了 radar detect widths 含 160MHz。
#      若所处环境雷达检测导致 AP 起不来，把 htmode 退回 'HE80'（36 起 80MHz 非 DFS，最稳）。
#   ✅ 真机实测（2026-09-21 20:38，带 setsid 自动回滚守护）：改为此值 + wifi reload 后
#      **5 秒** AP 即恢复，iwinfo 报 `HT Mode: EHT160`，未触发 DFS 阻塞；
#      已关联的 Wi-Fi 6 客户端仍按 160MHz HE-MCS 11 HE-NSS 2 协商（向下兼容无损），
#      EHT 4096-QAM 的收益待 Wi-Fi 7 客户端接入时体现。
if [ "$(uci -q get wireless.radio1.band)" = "5g" ]; then
	uci -q set wireless.radio1.channel='36'
	uci -q set wireless.radio1.htmode='EHT160'
	uci -q set wireless.radio1.country='CN'
fi
uci -q commit wireless

exit 0
