#!/bin/sh
# SPDX-License-Identifier: MIT
# H5000M 系统级优化 —— 首次开机由 uci-defaults 执行一次，执行后自动删除。
#
# 三项：① zram 内存压缩交换 ② 无线客户端互通（关 AP 隔离）③ 启用四核均衡调度。
# proxy_arp_pvlan 不在这里做，它在 /etc/sysctl.d/99-mt5700-lan.conf 里，
# 由 sysctl 服务加载（写在这里的话开机太早，br-lan 还没建好）。

# ---------- 1. zram 内存压缩交换（512M）----------
# H5000M 物理内存 1GB。参考固件（Mwrt）实测 zram0 ≈ 494MB，这里取 512M。
# zram 本身就是「内存压缩」：把不活跃页压缩后仍留在 RAM 里，
# 比写磁盘快几个数量级；H5000M 是 eMMC，频繁写 swap 还会缩短寿命，zram 完全避开。
#
# 算法固定 lzo：OpenWrt 的 zram.init 注释明写 "default to lzo, which is always
#   available"，这是唯一保证内核一定支持的算法，不写死就有开机失败的风险。
#   想要更高压缩率可改 zstd，代价是压缩/解压更吃 CPU ——
#   改 /etc/config/system 的 zram_comp_algo 即可，改之前先
#   cat /sys/block/zram0/comp_algorithm 确认该算法在内核里真的存在。
#
# 注意：zram 上限是「压缩后的数据上限」，实际占用的物理内存约为此值的
# 1/2 ~ 1/3，并不会真的吃掉 512M 物理内存。
# ⚠️ 脚本名是 /etc/init.d/zram，不是 zram-swap：
#   package/system/zram-swap/Makefile 里写的是
#     $(INSTALL_BIN) ./files/zram.init $(1)/etc/init.d/zram
#   —— 包名与实际安装的 init 脚本名不一致（真机已核实：参考固件的
#      /etc/init.d/ 下只有 zram）。写错名字会让整段被静默跳过。
#   这里两个名字都探测，兼容不同版本。
ZRAM_INIT=""
for CANDIDATE in /etc/init.d/zram /etc/init.d/zram-swap; do
	[ -x "$CANDIDATE" ] && {
		ZRAM_INIT="$CANDIDATE"
		break
	}
done

if [ -n "$ZRAM_INIT" ]; then
	uci -q set system.@system[0].zram_size_mb='512'
	uci -q set system.@system[0].zram_comp_algo='lzo'
	uci -q commit system
	"$ZRAM_INIT" enable
	logger -t mt5700-sys "已配置 zram 512M（$ZRAM_INIT）"
else
	logger -t mt5700-sys "未找到 zram init 脚本，跳过 zram 配置"
fi

# ---------- 2. 无线：关闭客户端隔离 ----------
# isolate=1 是 AP 隔离，同一 SSID 下的设备互相不可见。
# MLO 场景下同一台客户端的多个射频会被当成不同设备、彼此隔离，
# 表现为「连上 WiFi 却访问不了同网段设备（NAS/投屏/另一台手机）」。
# OpenWrt 默认本就是 0，这里显式写一遍，防止固件模板或 MLO 路径把它打开。
for SECTION in $(uci -q show wireless | awk -F= '$2 == "wifi-iface" { print $1 }'); do
	uci -q set "${SECTION}.isolate"='0'
done
uci -q commit wireless

# ---------- 3. 四核均衡调度：启用 mt5700-smp（静态中断亲和）----------
# 为什么不用 irqbalance（2026-09-21 真机实测）：
#   irqbalance 全程只动了以太网的两个中断（67→CPU1、68→CPU3），对负载最大的
#   无线（IRQ 79，186 万次）与 USB 5G 模组（IRQ 74，10 万次）**毫无作为** ——
#   它们的 smp_affinity 一直是 f（全核掩码），但计数 100% 落在 CPU0。
# mt5700-smp 按中断负载贪心分配到最轻的核，实测结果：
#   CPU0=无线 IRQ79、CPU1=USB/5G IRQ74、CPU2=eth IRQ68、CPU3=eth IRQ67
#   —— 四核都有活干，不再是「一核干活三核围观」。
#
# ⚠️ 两个必须知道的边界：
#   1. 与 irqbalance 互斥（都写 /proc/irq/*/smp_affinity），
#      本服务启动时会自动停用 irqbalance，无需另外操作。
#   2. **IRQ 79（无线 mt7996e）的亲和不可写**：echo 到 smp_affinity 返回 RC=1，
#      affinity_hint=0、effective_affinity=0，停掉 irqbalance 后重试同样失败
#      —— PCIe MSI 在驱动层没实现 irq_set_affinity，属硬件/驱动限制。
#      所以做不到「完全均分」，CPU0 注定要扛无线硬中断；
#      收包软中断那一半由 mt5700-rps 避开 CPU0 来补偿（见该文件注释）。
if [ -x /etc/init.d/mt5700-smp ]; then
	/etc/init.d/mt5700-smp enable 2>/dev/null || true
	logger -t mt5700-sys "已启用 mt5700-smp（静态中断亲和，替代 irqbalance）"
fi

# ---------- 4. NTP 换成国内服务器 ----------
# 依据：参考固件（Mwrt）实测用的是腾讯/阿里/国家授时中心。
# OpenWrt 默认的 pool.ntp.org 在国内解析与往返都慢，5G CPE 冷启动后
# 系统时间可能要拖很久才同步 —— 时间不对会让 HTTPS 证书校验失败，
# 表现为「能上网但所有 https 站点都报证书错误」。
# ★ 2026-09-30：从列表里**去掉 cn.ntp.org.cn**。真机实测（192.168.10.1）：
#     nslookup cn.ntp.org.cn 223.5.5.5
#       Address: 111.203.6.13      ← 公网
#       Address: 10.48.49.44       ← **10/8 私网地址**
#   而本机 dnsmasq 开着 `stop-dns-rebind`（dhcp.@dnsmasq[0].rebind_protection=1），
#   于是每几分钟就刷一条
#     daemon.warn dnsmasq: possible DNS-rebind attack detected: cn.ntp.org.cn
#   并且 ntpd 对这个名字的解析被拦掉、该源实际作废。四个源里剩下三个仍然好用
#   （设备时间实测准确），所以这条不是"掉线"，而是**日志噪声 + 一个源白配**；
#   但它会掩盖真正的 DNS 反绑定告警（那条是要当安全信号看的）—— 所以删掉它。
#   不采用"给该域名加 rebind 白名单"的做法：`rebind_domain` 是整域放行，
#   为 NTP 一个名字削弱反绑定保护不划算。
#   只在 system.ntp 段已存在时改，避免给别的机型凭空建段。
if uci -q get system.ntp >/dev/null 2>&1; then
	uci -q delete system.ntp.server 2>/dev/null
	for SVR in ntp.tencent.com ntp1.aliyun.com ntp.ntsc.ac.cn; do
		uci -q add_list "system.ntp.server=$SVR"
	done
	uci -q set system.ntp.enabled='1'
	uci -q set system.ntp.enable_server='0'
	uci -q commit system
fi

# ---------- 5. apk 索引缓存持久化：启用 apk-index-cache ----------
# 症状：每次重启后 LuCI「系统 → 软件」都用不了 —— 可用包列表是空的、点安装/卸载
#   失败，必须先手动点一次右上角「Update lists…」。
# 根因：/var 是 tmpfs（真机 `readlink -f /var` 输出 /tmp），而 apk 的索引缓存目录
#   /var/cache/apk 就在里面 —— 索引只活在内存里，重启必丢；丢了 apk 还不会自动补
#   （实测：缓存为空时 `apk list -a` 返回 0 且不联网拉取，页面拿到空数组却不报错）。
# 修法：apk-index-cache（START=96）每次开机把 /var/cache/apk 换成指向 overlay 持久
#   目录 /usr/share/apk/cache 的软链，并在索引不齐时后台补一次 update。
#   论证与实测数据写在该文件头部；SelfCheck 的 C8 负责守住这条启用链。
#
# ⚠️ 这一步不能省：Files/ 覆盖层只负责**把文件放进固件**，OpenWrt 不会因为它躺在
#   /etc/init.d/ 下就自动启用 —— 少这一步，脚本在固件里却永不执行，故障照旧，
#   而排查时几乎不会想到「脚本其实从来没跑过」。
if [ -x /etc/init.d/apk-index-cache ]; then
	chmod 0755 /etc/init.d/apk-index-cache 2>/dev/null
	/etc/init.d/apk-index-cache enable 2>/dev/null || true
	# ★ `enable` 只建 /etc/rc.d/S96 软链，而 procd 的 rc 队列在开机那一刻就**一次性
	#   展开完了**（procd 的 rcS 只 glob 一次 /etc/rc.d/S*，之后新建的软链进不了本次队列）。
	#   本脚本跑在 S10，也就是说光 enable 的话，apk-index-cache 要等到**下一次开机**
	#   才真正运行 —— 而它治的正是「每次重启后软件页都用不了」，首启等于没治。
	#   这里补一次 start（该脚本幂等，且内部对后台 apk update 有 timeout 300 保护），
	#   让首次开机就生效；之后各次开机由 S96 正常拉起。
	#   ⚠️ mt5700-smp / mt5700-rps **不在这里补 start**：前者在 S10 时无线 IRQ 尚未注册、
	#      后者要 stop 的 packet_steering（S25）此刻还没启动 —— 补了反而引入时序偏差；
	#      它们由 hotplug.d/net/30-mt5700-rps 与「第二次开机」兜住。
	#      这条时序结论与 99-mt5700-net 第 4 节那句「S* glob 开机那一刻就展开完了」
	#      是同一条机制，只是当时没意识到它也适用于我们自己 enable 的服务。
	/etc/init.d/apk-index-cache start 2>/dev/null || true
	logger -t mt5700-sys "已启用并启动 apk-index-cache（首启即生效，不必等下次重启；apk 索引跨重启保留）"
fi

# ---------- 6. uhttpd 的 CGI 超时：60 → 300 秒 ----------
# 症状：LuCI「系统 → 软件」点「Update lists…」，等一下弹出
#   「无法执行 apk update 命令：SyntaxError: Unexpected end of JSON input」。
#
# 根因（2026-09-27 真机复现，**计时 60.2 秒**，不是推测）：
#   /usr/libexec/package-manager-call 是「跑完 apk update 之后才 json_dump」，
#   中间一个字节都不输出；而 uhttpd 默认 `-t 60`（本文件下面的 script_timeout=60）
#   到点就把 CGI 那条连接关掉 —— HTTP 200 + **空 body**。
#   前端 fs.js 的 handleCgiIoReply 对 'json' 类型走 `res.json()`，
#   空字符串直接抛 SyntaxError: Unexpected end of JSON input（就是那句报错）。
#   ★ 被掐掉的只是 cgi-io，**孙进程 apk update 会继续跑**（实测存活 68 分钟），
#     期间一直占着 /tmp/ipkg.lock 与 apk 数据库锁 → 再点一次就彻底没反应。
#     （并发点击那条已由 Handles.sh 把 `flock -x` 改成 `flock -n` 兜住，
#      这里解决的是「第一次点击就注定失败」。）
#
# 为什么必须调：本机 WAN 是 5G 漫游，6 个源逐个下、还常被截断重试
#   （实测 `wget: exited with error 4` / `unexpected end of file`），
#   apk update 一两分钟是常态。60 秒的预算 ＝「Update lists 永远失败」，
#   而这跟包管理器本身好不好完全无关。
#
# 取值 300 秒的理由：再长收益很小（超过 5 分钟的下不了本来也难成），
#   而 CGI 预算是「一个挂死的脚本能占住一条连接多久」的上限，不宜无节制放大。
#   想回退：uci set uhttpd.main.script_timeout='60'; uci commit uhttpd;
#           /etc/init.d/uhttpd restart
# 只动 script_timeout，**不动 network_timeout(=30)** —— 后者是读请求头的空闲上限，
#   与「CGI 跑多久」无关，一并放大只会放宽无谓的连接占用。
if [ -f /etc/config/uhttpd ]; then
	CUR_HTTPD_T="$(uci -q get uhttpd.main.script_timeout)"
	if [ "$CUR_HTTPD_T" != "300" ]; then
		uci -q set uhttpd.main.script_timeout='300'
		uci -q commit uhttpd
		logger -t mt5700-sys "uhttpd.script_timeout: ${CUR_HTTPD_T:-未设置} → 300（慢链路下软件页 Update lists 不再被 60 秒掐断）"
	fi
fi

exit 0
