#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# H5000M / MT7987A：收包软中断（RPS/XPS）的多核分摊
#
# ── 三层事实（均为 2026-09-21 真机实测，非推测）─────────────────────────
#   1. 无线 mt7996e 硬中断（IRQ 79）与 USB 5G 模组（IRQ 74）**100% 落在 CPU0**，
#      累计百万次量级从未迁移；irqbalance 全程只动了以太网的两个（67→CPU1、68→CPU3）。
#      单个 MSI 中断只能被一个核响应 —— **smp_affinity 写成全核 f 也不等于分摊**，
#      内核仍固定选一个核（实测就是 CPU0）。硬件层面劈不开，只能靠 RPS 分流。
#   2. 固件默认 rps_cpus 是**单核掩码**（phy0.1-ap0=4 → CPU2、eth2=8 → CPU3），
#      等于把所有收包处理强制塞给一个核。
#   3. 8 条并发 TCP 流压测 12 秒的对比（这是本脚本最终选型的依据）：
#        rps_cpus=f（全核）      → CPU0 占 NET_RX **42%**、softirq **47.5%**
#        rps_cpus=e（排除 CPU0） → CPU0 占 NET_RX **15%**、softirq **13%**
#                                  其余三核 25% / 33% / 25%
#      ★ 关键认知：收包软中断应当**避开该接口硬中断所在的核** ——
#        硬中断已占住 CPU0，若 RPS 仍把软中断派给它，该核就会被双重占用。
#        这一点来自厂家实现（higowrt 固件 /sbin/smp.sh 的 MT7990_whnat 分支）：
#        有线接口 rps = 0xe（排除 CPU0），无线接口 rps = 0x7（排除 CPU3）。
#
# ⚠️ 验证必须用**多条并发流**：RPS 按 flow hash 选核，同一条 TCP 流的所有包
#    必然落在同一个核（为避免乱序）。单流压测会误判成"全核掩码反而更差"
#    —— 实测单流时 CPU0 确实会占到 92%。
#
# ── 边界 ────────────────────────────────────────────────────────────────
#   本脚本只写 /sys/class/net/*/queues/*/{rps,xps}_cpus，**不碰 smp_affinity**，
#   所以与 irqbalance / mt5700-smp（硬中断亲和）都不冲突，可以并存。

START=95
STOP=10

# 无线硬中断在 /proc/interrupts 里的设备名特征
WIFI_IRQ_MATCH='mt76|mt79|mt798|wifi|phy[0-9]|wlan|ra[0-9]|rai[0-9]'

log() {
	logger -t mt5700-rps "$1"
}

ncpu_get() {
	grep -c '^processor' /proc/cpuinfo
}

# 无线接口名判定
is_wifi_iface() {
	case "$1" in
		phy*) return 0 ;;
		*-ap*) return 0 ;;
		ra0|rai0*) return 0 ;;
		wlan*) return 0 ;;
	esac
	return 1
}

# 无线硬中断当前实际落在哪个核（/proc/interrupts 里取计数最大的那一列）
# 返回 CPU 序号；找不到（无无线 / 驱动改名）时输出空
wifi_irq_cpu() {
	awk -v ncpu="$1" -v m="$WIFI_IRQ_MATCH" '
		$1 ~ /^[0-9]+:$/ {
			if ($0 ~ m) {
				best = -1; dom = 0
				for (i = 0; i < ncpu; i++) {
					v = $(i + 2) + 0
					if (v > best) { best = v; dom = i }
				}
				print dom
				exit
			}
		}' /proc/interrupts
}

# 等 br-lan（有线/网桥就绪的判据），最多 10 秒。
# ★ 不要在这里死等无线：无线接口由 wpad 稍后建立 —— 真机实测 mt7996e 约开机 12 秒
#   probe、**25 秒**才进入 ap0 模式，而本脚本在 S95 跑，死等会白白拖慢启动。
#   原先的实现就是只等 br-lan 却指望无线队列已存在，导致无线 RPS 静默落空
#   （且因为"其它队列 >0"连告警都不会触发）。
#   现在缺的无线队列由 Files/etc/hotplug.d/net/30-mt5700-rps 在接口 add 事件上补设。
wait_ifaces() {
	local i=0
	while [ $i -lt 10 ]; do
		[ -d /sys/class/net/br-lan ] && return 0
		i=$(( i + 1 ))
		sleep 1
	done
	return 1
}

start() {
	local ncpu all_dec all_hex wifi_cpu wifi_dec wifi_hex wifi_n=0 other_n=0
	local iface mask f

	ncpu="$(ncpu_get)"
	if [ "$ncpu" -lt 2 ]; then
		log "CPU 数=$ncpu，无需分摊，跳过"
		return 0
	fi

	wait_ifaces || log "警告：br-lan 20 秒内未就绪，仅设置当前已存在的接口"

	# ── 先把 netifd 的 packet steering 摘掉，否则它会抢同一个文件 ────────────
	# /etc/init.d/packet_steering（START=25）与本脚本（START=95）**都写 rps_cpus**，
	# 而它用的是「每队列单核掩码」（cpu_mask(cpu) = 1 << cpu），正是实测三档里
	# 最差的一档。更麻烦的是它注册了 network / firewall / interface.* 三个触发器：
	# 2026-09-22 实锤 —— 用户在 LuCI 保存一次「网络」或「防火墙」配置，
	# config.change 事件就会让它 reload，把本脚本设的 e/f 改回 4/8。
	#
	# 必须在本脚本里兜底，光靠 uci-defaults 的 disable 不够：
	#   uci-defaults 在 S10 跑，S25 在它**之后**，而 rc 序列的 /etc/rc.d/S* glob
	#   开机那一刻就展开完了 —— disable 只删链接，挡不住本次开机已经起来的实例。
	#   本脚本 S95 > S25，此时它已在跑，这里 stop 才能真正摘掉注册与触发器。
	#
	# 两道都是幂等的：disable 只是删一个软链，stop 一个没跑的服务是 no-op。
	# 只在确认注册着时才 stop 并记日志，避免每次 hotplug 都刷一条日志。
	if [ -x /etc/init.d/packet_steering ]; then
		/etc/init.d/packet_steering disable 2>/dev/null || true
		if ubus call service list '{"name":"packet_steering"}' 2>/dev/null \
			| grep -q '"packet_steering"'; then
			/etc/init.d/packet_steering stop 2>/dev/null || true
			log "已停用 netifd packet steering（其单核掩码会在配置变更时覆盖本脚本），RPS 由本脚本独占"
		fi
	fi

	all_dec=$(( (1 << ncpu) - 1 ))
	all_hex="$(printf '%x' "$all_dec")"

	# 无线接口的 RPS 排除掉「无线硬中断所在核」
	wifi_hex="$all_hex"
	wifi_cpu="$(wifi_irq_cpu "$ncpu")"
	if [ -n "$wifi_cpu" ]; then
		wifi_dec=$(( all_dec & ~(1 << wifi_cpu) ))
		if [ "$wifi_dec" -gt 0 ]; then
			wifi_hex="$(printf '%x' "$wifi_dec")"
		else
			wifi_hex="$all_hex"
		fi
		log "无线硬中断在 CPU$wifi_cpu，无线接口 RPS 用 0x$wifi_hex（避开该核）"
	else
		log "未识别到无线硬中断，全部接口统一用全核掩码 0x$all_hex"
	fi

	for f in /sys/class/net/*/queues/rx-*/rps_cpus; do
		[ -e "$f" ] || continue
		iface="${f#/sys/class/net/}"
		iface="${iface%%/*}"
		if is_wifi_iface "$iface"; then
			mask="$wifi_hex"
			wifi_n=$(( wifi_n + 1 ))
		else
			mask="$all_hex"
			other_n=$(( other_n + 1 ))
		fi
		echo "$mask" > "$f" 2>/dev/null
	done

	# XPS（发包）与硬中断核无关，统一全核
	local tx_n=0
	for f in /sys/class/net/*/queues/tx-*/xps_cpus; do
		[ -e "$f" ] || continue
		echo "$all_hex" > "$f" 2>/dev/null && tx_n=$(( tx_n + 1 ))
	done

	if [ "$wifi_n" -eq 0 ] && [ "$other_n" -eq 0 ]; then
		log "警告：一个接收队列都没设上，接口可能尚未就绪"
		return 1
	fi

	# 无线队列在 S95 时通常还没出现（wpad 未建立接口），属正常时序，不算异常；
	# 由 hotplug.d/net/30-mt5700-rps 在接口 add 时补设。
	[ "$wifi_n" -eq 0 ] && log "无线队列尚未就绪（wpad 未建接口），交由 hotplug 补设"

	log "RPS 完成（$ncpu 核）：无线队列 $wifi_n 个=0x$wifi_hex、其它队列 $other_n 个=0x$all_hex；XPS $tx_n 个=0x$all_hex"
}

stop() {
	local f
	for f in /sys/class/net/*/queues/rx-*/rps_cpus; do
		[ -e "$f" ] && echo 0 > "$f" 2>/dev/null
	done
	for f in /sys/class/net/*/queues/tx-*/xps_cpus; do
		[ -e "$f" ] && echo 0 > "$f" 2>/dev/null
	done
	log "已还原为内核默认（RPS/XPS 关闭）"
}

restart() {
	stop
	start
}
